rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidChatTopic(data, uid, topicId) {
      return data.keys().hasAll(['id', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'passageReference', 'lastMessagePreview', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == topicId && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.createdAt is number && data.updatedAt is number
        && (!('userId' in data) || (data.userId is string && data.userId == uid))
        && (!('passageReference' in data) || (data.passageReference is string && data.passageReference.size() <= 120))
        && (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240));
    }

    function isValidBiblicalTheme(data, uid, themeId) {
      return data.keys().hasAll(['id', 'title', 'scripture', 'approach', 'category', 'summary', 'application', 'isGenerated', 'createdAt', 'sourceMode'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'scripture', 'approach', 'category', 'summary', 'application', 'outlineHints', 'isGenerated', 'createdAt', 'updatedAt', 'sourceMode', 'sourceInput', 'isSaved'])
        && data.id is string && data.id == themeId && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.scripture is string && data.scripture.size() >= 1 && data.scripture.size() <= 140
        && data.approach in ['Expositivo', 'Temático', 'Pastoral', 'Devocional']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 800
        && data.application is string && data.application.size() >= 1 && data.application.size() <= 800
        && data.isGenerated is bool
        && data.createdAt is number
        && data.sourceMode in ['scripture', 'category', 'topic']
        && (!('userId' in data) || (data.userId is string && data.userId == uid))
        && (!('updatedAt' in data) || data.updatedAt is number)
        && (!('isSaved' in data) || data.isSaved is bool)
        && (!('sourceInput' in data) || (data.sourceInput is string && data.sourceInput.size() <= 200))
        && (!('outlineHints' in data) || (data.outlineHints is list && data.outlineHints.size() <= 8 && (data.outlineHints.size() == 0 || data.outlineHints[0] is string)));
    }

    // Acesso para o UID fixo pastoral (sem necessidade de login) ou via autenticação
    match /users/{uid} {
      allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);

      match /pastoral_sermons/{sermonId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /sermons/{sermonId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /series/{seriesId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /illustrations/{illustrationId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /theological_topics/{topicId} {
        allow get, list, delete: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
        allow create, update: if (uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid))
          && isValidId(topicId)
          && isValidChatTopic(request.resource.data, uid, topicId);
      }

      match /theological_chat/{messageId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /theological_sieve/{sieveId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /biblical_themes/{themeId} {
        allow get, list, delete: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
        allow create, update: if (uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid))
          && isValidId(themeId)
          && isValidBiblicalTheme(request.resource.data, uid, themeId);
      }

      match /chat_meta/{metaId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /tombstones/{tombstoneId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }
    }

    // Coleção direta pastoral_sermons com verificação do UID pastoral
    match /pastoral_sermons/{sermonId} {
      allow read, write: if resource == null || resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || request.resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1');
    }

    // Coleção direta sermons para compatibilidade regressiva
    match /sermons/{sermonId} {
      allow read, write: if resource == null || resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || request.resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1');
    }

    match /tombstones/{tombstoneId} {
      allow read, write: if resource == null || resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || request.resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1');
    }
  }
}


