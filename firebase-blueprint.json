{
  "entities": {
    "Sermon": {
      "title": "Sermon",
      "description": "Represents an expository sermon in the pastoral library, synchronized across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "theme": { "type": "string" },
        "scripture": { "type": "string" },
        "introduction": { "type": "string" },
        "biblicalContext": { "type": "string" },
        "conclusion": { "type": "string" },
        "pastoralAppeal": { "type": "string" },
        "date": { "type": "string" },
        "style": { "type": "string" },
        "churchProfile": { "type": "string" },
        "audience": { "type": "string" },
        "bibleVersion": { "type": "string" },
        "isOutline": { "type": "boolean" },
        "duration": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "derivation": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "scripture"]
    },
    "ExpositorySeries": {
      "title": "ExpositorySeries",
      "description": "Represents a thematic or expository sermon series.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "book": { "type": "string" },
        "theme": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "Tombstone": {
      "title": "Tombstone",
      "description": "Tracks deleted sermons across devices to prevent resurrected items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deletedAt": { "type": "number" }
      },
      "required": ["id", "deletedAt"]
    },
    "VisualIllustration": {
      "title": "VisualIllustration",
      "description": "Pulpit oral illustration and homiletical narrative.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "story": { "type": "string" },
        "moral": { "type": "string" },
        "scripture": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "story"]
    },
    "TheologicalChatMessage": {
      "title": "TheologicalChatMessage",
      "description": "Consultor Biblico e Teologico message synchronized across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "role", "content", "timestamp"]
    },
    "TheologicalChatTopic": {
      "title": "TheologicalChatTopic",
      "description": "Consultor Biblico e Teologico conversation topic/subject thread synchronized across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "passageReference": { "type": "string", "maxLength": 120 },
        "lastMessagePreview": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "createdAt", "updatedAt"]
    },
    "TheologicalSieveEntry": {
      "title": "TheologicalSieveEntry",
      "description": "Crivo Teologico analysis entry synchronized across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "scripture": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "GeneratedHomileticTheme": {
      "title": "GeneratedHomileticTheme",
      "description": "Homiletic theme generated and saved by the user in the Biblical Themes Bank.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scripture": { "type": "string", "minLength": 1, "maxLength": 140 },
        "approach": { "type": "string", "maxLength": 40 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
        "application": { "type": "string", "minLength": 1, "maxLength": 800 },
        "outlineHints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isGenerated": { "type": "boolean" },
        "isSaved": { "type": "boolean" },
        "sourceMode": { "type": "string", "maxLength": 24 },
        "sourceInput": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "scripture", "approach", "category", "summary", "application", "isGenerated", "createdAt", "sourceMode"]
    },
    "PreachingPlan": {
      "title": "PreachingPlan",
      "description": "Preaching planning calendar entry synchronized across devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "serviceType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scripture": { "type": "string", "maxLength": 180 },
        "themeOrTitle": { "type": "string", "maxLength": 200 },
        "seriesName": { "type": "string", "maxLength": 140 },
        "preacher": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["Planejado", "Em preparo", "Pronto", "Pregado"] },
        "linkedSermonId": { "type": "string", "maxLength": 128 },
        "linkedSermonTitle": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "serviceType", "preacher", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}/pastoral_sermons/{sermonId}": {
      "schema": "Sermon",
      "description": "Primary user-scoped pastoral sermons collection synchronized across desktop and mobile in real-time."
    },
    "/users/{uid}/sermons/{sermonId}": {
      "schema": "Sermon",
      "description": "Legacy user-scoped pastoral sermons collection."
    },
    "/users/{uid}/series/{seriesId}": {
      "schema": "ExpositorySeries",
      "description": "User-scoped expository series collection."
    },
    "/users/{uid}/illustrations/{illustrationId}": {
      "schema": "VisualIllustration",
      "description": "User-scoped pulpit illustrations collection."
    },
    "/users/{uid}/theological_topics/{topicId}": {
      "schema": "TheologicalChatTopic",
      "description": "User-scoped Consultor Biblico topic threads synchronized across devices."
    },
    "/users/{uid}/theological_chat/{messageId}": {
      "schema": "TheologicalChatMessage",
      "description": "User-scoped Consultor Biblico chat messages synchronized across devices."
    },
    "/users/{uid}/theological_sieve/{sieveId}": {
      "schema": "TheologicalSieveEntry",
      "description": "User-scoped Crivo Teologico history synchronized across devices."
    },
    "/users/{uid}/biblical_themes/{themeId}": {
      "schema": "GeneratedHomileticTheme",
      "description": "User-scoped generated and saved biblical homiletic themes synchronized across devices."
    },
    "/users/{uid}/preaching_plans/{planId}": {
      "schema": "PreachingPlan",
      "description": "User-scoped preaching planning entries synchronized across devices."
    },
    "/users/{uid}/tombstones/{tombstoneId}": {
      "schema": "Tombstone",
      "description": "User-scoped deleted items tombstone collection."
    },
    "/pastoral_sermons/{sermonId}": {
      "schema": "Sermon",
      "description": "Primary pastoral sermons collection synchronized across desktop and mobile in real-time."
    },
    "/sermons/{sermonId}": {
      "schema": "Sermon",
      "description": "Unified pastoral sermons collection synchronized in real-time."
    },
    "/series/{seriesId}": {
      "schema": "ExpositorySeries",
      "description": "Expository series collection synchronized in real-time."
    },
    "/tombstones/{tombstoneId}": {
      "schema": "Tombstone",
      "description": "Deleted items tombstone collection for multi-device sync integrity."
    }
  }
}
