rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Acesso para o UID fixo pastoral (sem necessidade de login) ou via autenticação
    match /users/{uid} {
      allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);

      match /pastoral_sermons/{sermonId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /sermons/{sermonId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /series/{seriesId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /illustrations/{illustrationId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /tombstones/{tombstoneId} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }

      match /{document=**} {
        allow read, write: if uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == uid);
      }
    }

    // Coleção direta pastoral_sermons com verificação do UID pastoral
    match /pastoral_sermons/{sermonId} {
      allow read, write: if resource == null || resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || request.resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1');
    }

    // Coleção direta sermons para compatibilidade regressiva
    match /sermons/{sermonId} {
      allow read, write: if resource == null || resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || request.resource.data.userId == '2PG5uxWMgeg3eE10yQbQVFDpHUu1' || (request.auth != null && request.auth.uid == '2PG5uxWMgeg3eE10yQbQVFDpHUu1');
    }

    match /tombstones/{tombstoneId} {
      allow read, write: if true;
    }
  }
}


